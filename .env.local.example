# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive (opção 1 — RECOMENDADA: OAuth de um usuário de verdade)
# Conta de serviço não tem espaço de armazenamento próprio: ela cria pastas, mas
# nenhum arquivo sobe. Autenticando como a dona do Drive, cada foto nasce no nome
# dela e ocupa o espaço que ela já paga.
# O refresh token NÃO existe no Google Cloud — ele nasce no consentimento.
# Gere abrindo /api/drive/autorizar?secret=<TEST_DRIVE_SECRET> no navegador,
# ou por: node scripts/autorizar-drive.mjs (veja o README).
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=1//...
# Opcional: só se o app estiver atrás de um proxy que mude o host.
# GOOGLE_OAUTH_REDIRECT_URI=https://seu-app.vercel.app/api/drive/autorizar

# Google Drive (opção 2 — conta de serviço; só serve com Drive compartilhado)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Drive (opção 3 — conta de serviço com variáveis separadas)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-email@projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Pasta raiz no Google Drive. Aceita o ID (o trecho longo depois de /folders/)
# ou a URL inteira da pasta, copiada da barra de endereços.
# Com OAuth, basta ser uma pasta da conta autorizada.
# Com conta de serviço, a pasta precisa estar compartilhada com o client_email no
# nível "Editor" — e ainda assim o upload de arquivo falha por falta de cota.
# "root" não serve em nenhum dos casos.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567

# Diagnóstico do Drive (GET /api/test-drive?secret=<valor>)
TEST_DRIVE_SECRET=uma-senha-secreta-qualquer
