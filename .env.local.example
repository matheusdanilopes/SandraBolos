# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive — contas de serviço NÃO têm cota de armazenamento: numa pasta
# do "Meu Drive" o upload falha com "Service Accounts do not have storage quota".
# Use a opção A (conta Gmail pessoal) ou, no Google Workspace, a B com a pasta
# raiz dentro de um Drive compartilhado ou com GOOGLE_IMPERSONATE_USER.

# Opção A (recomendada) — OAuth da conta dona do Drive.
# Gere o refresh token com: node scripts/gerar-token-google-drive.mjs
GOOGLE_OAUTH_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REFRESH_TOKEN=1//0...

# Opção B — conta de serviço (usada só se as variáveis GOOGLE_OAUTH_* faltarem).
# JSON completo:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# ou variáveis separadas:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-email@projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Delegação em todo o domínio (Workspace): a conta de serviço age como este usuário.
# GOOGLE_IMPERSONATE_USER=sandra@seudominio.com.br

# ID da pasta raiz no Google Drive (ID longo alfanumérico, não "." ou caminho)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567

# Diagnóstico do Drive (GET /api/test-drive?secret=<valor>)
TEST_DRIVE_SECRET=uma-senha-secreta-qualquer
