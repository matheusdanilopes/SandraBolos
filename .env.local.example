# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive via OAuth (conta pessoal). Gere o refresh token com:
#   node scripts/get-drive-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxx

# ID da pasta raiz no Google Drive (ID longo alfanumérico, não "." ou caminho)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567

# Diagnóstico do Drive (GET /api/test-drive?secret=<valor>)
TEST_DRIVE_SECRET=uma-senha-secreta-qualquer
