# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Obrigatória: o app só acessa o banco com ela (as tabelas não aceitam a chave anon)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Drive via OAuth (conta pessoal). Gere o refresh token com:
#   node scripts/get-drive-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxx

# ID da pasta raiz no Google Drive (ID longo alfanumérico, não "." ou caminho)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567

# Diagnóstico do Drive: abra /api/test-drive com o app logado

# Assinatura do cookie de login (obrigatória em produção). Se ausente, usa SUPABASE_SERVICE_ROLE_KEY.
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-valor-aleatorio
